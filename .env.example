# Optional settings for local source-code execution only.
# Docker Compose sets MCP_HOST internally and mounts /run/secrets/mcp_bootstrap.json.
# Ordinary tool settings and project paths are managed by SQLite at /admin/config.
# Leave these unset to use defaults.
MCP_DB_PATH=
MCP_BOOTSTRAP_FILE=
MCP_HOST=127.0.0.1
MCP_PORT=8000
