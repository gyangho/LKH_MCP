# Local Oracle connection. Configure with actual Docker-published port and service/SID.
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_USER=MCP_READER
ORACLE_PASSWORD=CHANGE_ME

# Choose exactly ONE of SERVICE or SID, unless using ORACLE_DSN directly.
ORACLE_SERVICE=FREEPDB1
ORACLE_SID=
ORACLE_DSN=

# For Oracle 11g: set this to an extracted Oracle Instant Client 19 folder on Windows.
# For Oracle 12c+ it can remain blank to use Thin mode.
ORACLE_CLIENT_LIB_DIR=

# Optional: comma-separated owner-qualified or own table names (e.g. ITAM.ASSETS).
# The table list and preview tools refuse access if this list is empty.
ORACLE_ALLOWED_TABLES=

MCP_HOST=127.0.0.1
MCP_PORT=8000

# Graphify: list only explicitly trusted local project roots (Windows: use /).
# Multiple projects: ITAM=C:/Projects/ITAM;OTHER=D:/Projects/OTHER
# Graph must already exist at <project>/graphify-out/graph.json.
GRAPHIFY_PROJECTS=
# Optional absolute path to graphify.exe if the server process PATH cannot find it.
GRAPHIFY_EXECUTABLE=
# Default false: Graphify update modifies generated graph data in those projects.
GRAPHIFY_ALLOW_UPDATE=false
