{
  "openapi": "3.0.3",
  "info": {
    "title": "LKH MCP Oracle connections and repository approvals",
    "version": "1.1.0",
    "description": "Private administrator session required. Writes and repository checks require exact Origin/Host and X-LKH-Admin-Action: 1. Repository bindings select an Agent and an absolute path on that PC. Agents poll for assigned configuration; checks use scoped leases and return fixed status codes only. Changes cancel queued jobs and invalidate old check results; running jobs block execution-binding changes. Public skill source is downloaded from GitHub latest stable releases at installation."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001"
    }
  ],
  "security": [
    {
      "adminSession": []
    }
  ],
  "paths": {
    "/admin/api/oracle/connections": {
      "get": {
        "summary": "List administrator-visible profiles without passwords",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Connection"
                      }
                    }
                  },
                  "required": [
                    "connections"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or input format"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown connection"
          },
          "409": {
            "description": "Stale revision"
          },
          "413": {
            "description": "Body must be 1–12000 bytes"
          },
          "503": {
            "description": "Oracle, DPAPI or storage unavailable; details are redacted"
          }
        }
      },
      "post": {
        "summary": "Create a connection (maximum 20)",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or input format"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown connection"
          },
          "409": {
            "description": "Stale revision"
          },
          "413": {
            "description": "Body must be 1–12000 bytes"
          },
          "503": {
            "description": "Oracle, DPAPI or storage unavailable; details are redacted"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              }
            }
          }
        }
      }
    },
    "/admin/api/oracle/connections/{ident}": {
      "parameters": [
        {
          "in": "path",
          "name": "ident",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Replace profile using expected revision; blank password preserves it",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or input format"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown connection"
          },
          "409": {
            "description": "Stale revision"
          },
          "413": {
            "description": "Body must be 1–12000 bytes"
          },
          "503": {
            "description": "Oracle, DPAPI or storage unavailable; details are redacted"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete saved connection only; running queries may finish; Oracle data is unchanged",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or input format"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown connection"
          },
          "409": {
            "description": "Stale revision"
          },
          "413": {
            "description": "Body must be 1–12000 bytes"
          },
          "503": {
            "description": "Oracle, DPAPI or storage unavailable; details are redacted"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "revision"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/admin/api/oracle/connections/{ident}/test": {
      "parameters": [
        {
          "in": "path",
          "name": "ident",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Run fixed DUAL query with saved credentials, including disabled profiles",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields or input format"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown connection"
          },
          "409": {
            "description": "Stale revision"
          },
          "413": {
            "description": "Body must be 1–12000 bytes"
          },
          "503": {
            "description": "Oracle, DPAPI or storage unavailable; details are redacted"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/admin/api/repositories": {
      "get": {
        "summary": "List approved GitHub repositories",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "repositories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Repository"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown approval"
          },
          "409": {
            "description": "Stale revision, duplicate alias, maximum 10 or running job"
          },
          "413": {
            "description": "Body must be 1–2048 bytes"
          },
          "503": {
            "description": "Storage or migration unavailable"
          }
        }
      },
      "post": {
        "summary": "Create approval (maximum 10, unique alias)",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown approval"
          },
          "409": {
            "description": "Stale revision, duplicate alias, maximum 10 or running job"
          },
          "413": {
            "description": "Body must be 1–2048 bytes"
          },
          "503": {
            "description": "Storage or migration unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepositoryCreate"
              }
            }
          }
        }
      }
    },
    "/admin/api/repositories/{ident}": {
      "parameters": [
        {
          "in": "path",
          "name": "ident",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Modify approval; running jobs block; queued jobs cancelled on change",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repository"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown approval"
          },
          "409": {
            "description": "Stale revision, duplicate alias, maximum 10 or running job"
          },
          "413": {
            "description": "Body must be 1–2048 bytes"
          },
          "503": {
            "description": "Storage or migration unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepositoryUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke approval; running jobs block; queued jobs cancelled",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    },
                    "cancelled_jobs": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/Host/CSRF denied"
          },
          "404": {
            "description": "Unknown approval"
          },
          "409": {
            "description": "Stale revision, duplicate alias, maximum 10 or running job"
          },
          "413": {
            "description": "Body must be 1–2048 bytes"
          },
          "503": {
            "description": "Storage or migration unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-LKH-Admin-Action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "revision"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/admin/api/repositories/{ident}/test": {
      "post": {
        "summary": "Queue a read-only check on the repository-bound Agent. Does not fetch, pull or modify checkout. Expires after 180 seconds.",
        "parameters": [
          {
            "name": "ident",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "revision"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued; poll GET repositories for the result."
          },
          "400": {
            "description": "Missing Agent/path or invalid request"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Origin/CSRF denied or Agent disabled"
          },
          "404": {
            "description": "Unknown repository"
          },
          "409": {
            "description": "Stale revision or another check in progress"
          }
        }
      }
    },
    "/admin/agent/repositories": {
      "post": {
        "summary": "Agent configuration sync and leased connection-check result reporting. Paths are returned only on this authenticated Agent API.",
        "security": [
          {
            "agentBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "agent_id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent_id"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "agent_id": {
                        "type": "string"
                      },
                      "check_id": {
                        "type": "string"
                      },
                      "lease": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "agent_id",
                      "check_id",
                      "lease",
                      "code"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assigned projects, legacy-approved aliases and at most one leased check, or result acknowledgement."
          },
          "400": {
            "description": "Invalid payload or fixed result code"
          },
          "401": {
            "description": "Agent Bearer required"
          },
          "403": {
            "description": "Invalid, expired or changed connection-check lease"
          }
        }
      }
    },
    "/admin/healthz": {
      "get": {
        "summary": "Native loopback process liveness during installation/startup; normal MCP/Agent requests stay blocked until installation is ready.",
        "security": [],
        "responses": {
          "200": {
            "description": "Native server process is listening. Installer also checks version, PID and SCM parent before completing installation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "application": {
                      "type": "string",
                      "enum": [
                        "LKH-MCP"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "pid": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "status",
                    "application",
                    "version",
                    "pid"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lkh_admin_session"
      },
      "agentBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Create": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "host": {
            "type": "string",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service": {
            "type": "string",
            "maxLength": 128
          },
          "sid": {
            "type": "string",
            "maxLength": 128
          },
          "dsn": {
            "type": "string",
            "maxLength": 512,
            "description": "Optional credential-free DSN. If set, service and sid must be empty."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_tables": {
            "type": "string",
            "maxLength": 2000,
            "description": "Comma-separated TABLE or OWNER.TABLE. Empty denies table access; * alone allows all visible tables."
          },
          "enabled": {
            "type": "boolean"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 1024,
            "description": "Required for create. Empty on update preserves the stored password.",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "host",
          "port",
          "service",
          "sid",
          "dsn",
          "username",
          "allowed_tables",
          "enabled",
          "password"
        ],
        "additionalProperties": false
      },
      "Update": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "host": {
            "type": "string",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service": {
            "type": "string",
            "maxLength": 128
          },
          "sid": {
            "type": "string",
            "maxLength": 128
          },
          "dsn": {
            "type": "string",
            "maxLength": 512,
            "description": "Optional credential-free DSN. If set, service and sid must be empty."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_tables": {
            "type": "string",
            "maxLength": 2000,
            "description": "Comma-separated TABLE or OWNER.TABLE. Empty denies table access; * alone allows all visible tables."
          },
          "enabled": {
            "type": "boolean"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 1024,
            "description": "Required for create. Empty on update preserves the stored password.",
            "minLength": 0
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "host",
          "port",
          "service",
          "sid",
          "dsn",
          "username",
          "allowed_tables",
          "enabled",
          "password",
          "revision"
        ],
        "additionalProperties": false
      },
      "Connection": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "host": {
            "type": "string",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service": {
            "type": "string",
            "maxLength": 128
          },
          "sid": {
            "type": "string",
            "maxLength": 128
          },
          "dsn": {
            "type": "string",
            "maxLength": 512,
            "description": "Optional credential-free DSN. If set, service and sid must be empty."
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_tables": {
            "type": "string",
            "maxLength": 2000,
            "description": "Comma-separated TABLE or OWNER.TABLE. Empty denies table access; * alone allows all visible tables."
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          },
          "password_configured": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "host",
          "port",
          "service",
          "sid",
          "dsn",
          "username",
          "allowed_tables",
          "enabled",
          "id",
          "revision",
          "updated_at",
          "password_configured"
        ],
        "additionalProperties": false
      },
      "RepositoryCreate": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "repository": {
            "type": "string",
            "maxLength": 140,
            "description": "GitHub owner/repository, not a URL or local path"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "Selected Agent identity; existing migrated entries may be unbound."
          },
          "local_path": {
            "type": "string",
            "maxLength": 1024,
            "description": "Absolute local Windows Git checkout root on the selected Agent. UNC and traversal paths are rejected."
          }
        },
        "required": [
          "alias",
          "repository",
          "agent_id",
          "local_path"
        ],
        "additionalProperties": false
      },
      "RepositoryUpdate": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "repository": {
            "type": "string",
            "maxLength": 140,
            "description": "GitHub owner/repository, not a URL or local path"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "agent_id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "Selected Agent identity; existing migrated entries may be unbound."
          },
          "local_path": {
            "type": "string",
            "maxLength": 1024,
            "description": "Absolute local Windows Git checkout root on the selected Agent. UNC and traversal paths are rejected."
          }
        },
        "required": [
          "alias",
          "repository",
          "revision",
          "agent_id",
          "local_path"
        ],
        "additionalProperties": false
      },
      "Repository": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "repository": {
            "type": "string",
            "maxLength": 140,
            "description": "GitHub owner/repository, not a URL or local path"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          },
          "cancelled_jobs": {
            "type": "integer"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "description": "Selected Agent identity; existing migrated entries may be unbound."
          },
          "local_path": {
            "type": "string",
            "maxLength": 1024,
            "description": "Absolute local Windows Git checkout root on the selected Agent. UNC and traversal paths are rejected."
          },
          "connection_check": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "not_checked",
                  "pending",
                  "running",
                  "succeeded",
                  "failed"
                ]
              },
              "code": {
                "type": "string"
              },
              "checked_at": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "status",
              "code",
              "checked_at"
            ]
          }
        },
        "required": [
          "id",
          "alias",
          "repository",
          "revision",
          "updated_at",
          "agent_id",
          "local_path",
          "connection_check"
        ],
        "additionalProperties": false
      }
    }
  }
}
